  "S3": "第三页 · 万圣夜的名字（转钟楼转盘：点蜡烛、敲钟）",
  "S4": "第四页 · 吝啬鬼杰克（拉纸舌头：提灯人走出来）",
  "S5": "第五页 · 挨家讨饼（点门：门开、篮子装满）",
  "S6": "第六页 · 漂洋过海（拉纸舌头：靠岸，南瓜灯亮起）",
  "S7": "第七页 · 不给糖就捣蛋（点门：糖果雨）"
 },
 "script": [
  {
   "id": "S0-01",
   "role": "旁白",
   "text": "万圣节的夜里，一盏萝卜灯亮了起来。它要讲一个两千年的故事。"
  },
  {
   "id": "S1-01",
   "role": "芜芜",
   "text": "我的故事，要从两千年前的一堆篝火讲起。"
  },
  {
   "id": "S1-02",
   "role": "旁白",
   "text": "那时的爱尔兰，凯尔特人刚刚收完最后一捆麦子。"
  },
  {
   "id": "S1-03",
   "role": "旁白",
   "text": "他们过萨温节，点起篝火，迎接冬天。"
  },
  {
   "id": "S1-04",
   "role": "布丽德",
   "text": "篝火好暖和！冬天要来啦！"
  },
  {
   "id": "S1-05",
   "role": "布丽德",
   "text": "听说今晚，两个世界的门会变薄哦！",
   "instruction": "你说话的情感是surprised。",
   "gap": 0.8
  },
  {
   "id": "S2-01",
   "role": "旁白",
   "text": "传说这一夜，淘气的精灵会溜到人间来。"
  },
  {
   "id": "S2-02",
   "role": "精灵",
   "text": "呜？这里好热闹呀！"
  },
  {
   "id": "S2-03",
   "role": "爸爸",
   "text": "快戴上面具，让精灵以为我们是自己人！"
  },
  {
   "id": "S2-04",
   "role": "布丽德",
   "text": "我是一头小鹿！嘘，别笑出声。"
  },
  {
   "id": "S2-05",
   "role": "芜芜",
   "text": "这就是万圣节扮装，最早的样子。",
   "gap": 0.8
  },
  {
   "id": "S3-01",
   "role": "旁白",
   "text": "很多年后，十一月一日，成了纪念圣人的万圣节。"
  },
  {
   "id": "S3-02",
   "role": "小修士",
   "text": "当——当——点一支蜡烛，想念一个人。"
  },
  {
   "id": "S3-03",
   "role": "旁白",
   "text": "万圣节的前一晚，就叫万圣夜，All Hallows' Eve。"
  },
  {
   "id": "S3-04",
   "role": "芜芜",
   "text": "念着念着，就变成了 Halloween！",
   "gap": 0.8
  },
  {
   "id": "S4-01",
   "role": "旁白",
   "text": "爱尔兰人还爱讲一个故事，主角叫吝啬鬼杰克。"
  },
  {
   "id": "S4-02",
   "role": "小恶魔",
   "text": "放我下来！我保证不找你麻烦啦！"
  },
  {
   "id": "S4-03",
   "role": "杰克",
   "text": "嘿嘿，说话算话哦。"
  },
  {
   "id": "S4-04",
   "role": "旁白",
   "text": "后来杰克哪儿也去不了，只好提着萝卜灯，在夜里走啊走。"
  },
  {
   "id": "S4-05",
   "role": "芜芜",
   "text": "那盏灯……就是我的祖先！",
   "gap": 0.8
  },
  {
   "id": "S5-01",
   "role": "旁白",
   "text": "后来，孩子们会在万圣夜挨家挨户地唱歌。"
  },
  {
   "id": "S5-02",
   "role": "汤米",
   "text": "叮咚，我们来唱歌啦！"
  },
  {
   "id": "S5-03",
   "role": "老奶奶",
   "text": "拿去吧，热乎乎的灵魂饼。"
  },
  {
   "id": "S5-04",
   "role": "艾拉",
   "text": "芜芜，照亮一点，我们去下一家！"
  },
  {
   "id": "S5-05",
   "role": "旁白",
   "text": "在苏格兰，孩子们还会扮装表演，换点心吃。",
   "gap": 0.8
  },
  {
   "id": "S6-01",
   "role": "旁白",
   "text": "再后来，很多爱尔兰人坐大船，去了遥远的美洲。"
  },
  {
   "id": "S6-02",
   "role": "肖恩",
   "text": "看，新的家！那里的南瓜好大呀！"
  },
  {
   "id": "S6-03",
   "role": "芜芜",
   "text": "萝卜不好找，那就……接住我的火苗！"
  },
  {
   "id": "S6-04",
   "role": "橙橙",
   "text": "我……我亮了？"
  },
  {
   "id": "S6-05",
   "role": "旁白",
   "text": "就这样，南瓜灯诞生了。",
   "gap": 0.8
  },
  {
   "id": "S7-01",
   "role": "旁白",
   "text": "今天，每到十月三十一日的晚上，孩子们扮成女巫、幽灵和小猫。"
  },
  {
   "id": "S7-02",
   "role": "孩子们",
   "text": "不给糖，就捣蛋！"
  },
  {
   "id": "S7-03",
   "role": "橙橙",
   "text": "两千年，好长呀。"
  },
  {
   "id": "S7-04",
   "role": "芜芜",
   "text": "原来每一盏灯，都在照亮回家的路。",
   "rate": 0.9
  },
  {
   "id": "S7-05",
   "role": "旁白",
   "text": "万圣节快乐。今晚，记得给门口的小客人留一颗糖。",
   "rate": 0.9,
   "gap": 1.5
  }
 ]
}