  "script": [
    {"id": "S0-01", "role": "旁白", "text": "森林边的小木屋里，住着一个总戴着红帽子的小姑娘，大家都叫她小红帽。"},
    {"id": "S1-01", "role": "旁白", "text": "一天早上，妈妈烤好了一篮蛋糕。"},
    {"id": "S1-02", "role": "妈妈", "text": "外婆生病了，把蛋糕送过去吧。记住，路上不要和陌生人说话。"},
    {"id": "S1-03", "role": "小红帽", "text": "知道啦，妈妈！我很快就回来！"},
    {"id": "S1-04", "role": "旁白", "text": "小红帽挎上篮子，蹦蹦跳跳地出发了。", "gap": 0.8},
    {"id": "S2-01", "role": "旁白", "text": "森林里静悄悄的，大树后面，好像有什么在动。"},
    {"id": "S2-02", "role": "大灰狼", "text": "小姑娘，你一个人要去哪儿呀？"},
    {"id": "S2-03", "role": "小红帽", "text": "我去森林那头，给外婆送蛋糕。"},
    {"id": "S2-04", "role": "大灰狼", "text": "那边的花田可漂亮了，摘一束送给外婆吧。", "rate": 0.88},
    {"id": "S3-01", "role": "旁白", "text": "花田里，雏菊一朵接一朵地开了。"},
    {"id": "S3-02", "role": "小红帽", "text": "这朵给外婆，这朵也给外婆！"},
    {"id": "S3-03", "role": "旁白", "text": "她摘呀摘，却没发现，大灰狼悄悄溜走了。", "gap": 0.8},
    {"id": "S4-01", "role": "旁白", "text": "小红帽来到外婆家，床上的外婆，裹着厚厚的被子。"},
    {"id": "S4-02", "role": "小红帽", "text": "外婆，你的耳朵怎么这么大？", "instruction": "你说话的情感是surprised。"},
    {"id": "S4-03", "role": "大灰狼", "text": "为了更清楚地听你说话呀。"},
    {"id": "S4-04", "role": "小红帽", "text": "外婆，你的嘴巴怎么这么大？", "instruction": "你说话的情感是fearful。"},
    {"id": "S4-05", "role": "大灰狼", "text": "为了……一口把你吃掉！", "rate": 1.05},
    {"id": "S4-06", "role": "外婆", "text": "小红帽，快跑！我在衣柜里！", "rate": 1.05},
    {"id": "S5-01", "role": "旁白", "text": "就在这时，樵夫叔叔冲了进来。"},
    {"id": "S5-02", "role": "樵夫", "text": "大灰狼，看你往哪儿跑！"},
    {"id": "S5-03", "role": "旁白", "text": "大灰狼吓得夹着尾巴，逃进了森林深处。"},
    {"id": "S5-04", "role": "外婆", "text": "谢谢你，樵夫。小红帽，快过来让外婆抱抱。"},
    {"id": "S5-05", "role": "小红帽", "text": "外婆，我以后再也不在路上贪玩了！"},
    {"id": "S5-06", "role": "旁白", "text": "那天下午，小木屋里飘满了蛋糕的香味。", "rate": 0.88, "gap": 1.5}
  ]
}
